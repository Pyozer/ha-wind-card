{
  "name": "live-wind-card",
  "version": "0.3.2",
  "description": "Modern animated wind card for Home Assistant: speed, gusts, direction and history",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "watch": "vite build --watch --mode development",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "size": "node scripts/check-size.mjs",
    "lint": "eslint src demo test scripts",
    "format": "prettier --write src demo test scripts",
    "format:check": "prettier --check src demo test scripts",
    "check": "npm run lint && npm run format:check && npm run coverage && npm run build && npm run size"
  },
  "dependencies": {
    "@mdi/js": "7.4.47",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.11",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "yaml": "2.9.1"
  }
}
